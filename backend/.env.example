# Copy to .env and fill in real values. Never commit .env.
MONGODB_URI="mongodb://127.0.0.1:27017/hostel-management"

# Required. Minimum 32 characters - the server refuses to boot without it.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=30d

PORT=5000
NODE_ENV=development

# Comma-separated origins allowed to call this API (CORS allowlist).
CLIENT_ORIGINS=http://localhost:3000
